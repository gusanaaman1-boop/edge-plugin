// Generated by CMake at configure time. Do not edit EdgeVersion.h - edit this.
//
// A crash report, a support e-mail or a "it worked yesterday" needs to say
// WHICH build. The version alone does not: three builds can call themselves
// 0.7.0. The git description does, exactly.

#pragma once

namespace edge
{
    inline constexpr const char* kVersion     = "@EDGE_VERSION@";
    inline constexpr const char* kGitDescribe = "@EDGE_GIT_DESCRIBE@";
    inline constexpr const char* kBuildDate   = "@EDGE_BUILD_DATE@";
}
